<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LifeDashboard.App.Views.SportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeDashboard.App.ViewModels"
    x:DataType="vm:SportViewModel"
    Title="Sport">

    <CollectionView ItemsSource="{Binding Items}" Margin="{OnIdiom Phone='16,0', Default='28,0'}">
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,16,0,12">
                <Label Text="Sport" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityItem">
                <Border Style="{StaticResource Tile}" Padding="12" Margin="0,0,0,8">
                    <VerticalStackLayout>
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Details}" />
                        <Label Text="{Binding When}" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="Keine Aktivitäten." Style="{StaticResource Muted}" Margin="0,24" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
