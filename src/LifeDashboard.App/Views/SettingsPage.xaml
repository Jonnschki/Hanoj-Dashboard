<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LifeDashboard.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:LifeDashboard.App.Controls"
    xmlns:vm="clr-namespace:LifeDashboard.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="Einstellungen">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12', Default='28,24'}" Spacing="16" MaximumWidthRequest="900">
            <Label Text="Einstellungen" Style="{StaticResource PageTitle}" />

            <controls:TileView Title="Konten">
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Accounts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountItem">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{Binding ButtonText}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleAccountCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Kalender für die Spiegelung">
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Calendars}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarChoice">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Role}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Fremde Kalender (ICS-Abo, read-only)">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding IcsSubscriptions}">
                        <BindableLayout.EmptyView>
                            <Label Text="Noch keine Abos. Bitte z. B. einen Kunden, seinen Kalender in Outlook zu veröffentlichen, und füge den ICS-Link hier ein." Style="{StaticResource Muted}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:IcsItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Details}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Entfernen" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RemoveIcsCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Neues Abo" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Entry Text="{Binding NewIcsName}" Placeholder="Name, z. B. Kunde Müller GmbH" />
                    <Entry Text="{Binding NewIcsUrl}" Placeholder="https://… oder webcal://… (.ics)" IsPassword="True" />
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding NewIcsCategory}" Title="Bereich" />
                    <Button Text="Abo hinzufügen und testen" Style="{StaticResource SecondaryButton}" Command="{Binding AddIcsCommand}" HorizontalOptions="Start" />
                    <Label Text="{Binding IcsStatus}" Style="{StaticResource Muted}" />
                    <Label Text="Der Link ist geheim (wer ihn kennt, sieht den Kalender). Er wird nur im sicheren Speicher des Geräts abgelegt." Style="{StaticResource Muted}" FontSize="11" />
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Datenschutz-Regeln">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Privat → Arbeit (und umgekehrt)" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding DetailLevels}" SelectedItem="{Binding PrivateToWork}" />
                    <Label Text="BusyOnly = nur „Beschäftigt“, ohne Titel und Details (Standard). None = gar nicht spiegeln. Full = alle Details." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Sport">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Zielkalender für Strava-Aktivitäten" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding SportTargets}" SelectedItem="{Binding SportTarget}" ItemDisplayBinding="{Binding Name, x:DataType=vm:CalendarOption}" Title="Kalender wählen" />
                    <Label Text="Dieser Kalender wird mit Aktivitäten gefüllt, aber nicht in andere Kalender gespiegelt." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Daily Digest &amp; Watchlist">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Uhrzeit" FontAttributes="Bold" />
                    <TimePicker Time="{Binding DigestTime}" Format="HH:mm" />
                    <Label Text="Watchlist (kommagetrennt, leer = Standard)" FontAttributes="Bold" />
                    <Entry Text="{Binding Watchlist}" Placeholder="{Binding WatchlistPlaceholder}" />
                </VerticalStackLayout>
            </controls:TileView>

            <Button Text="Einstellungen speichern" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}" WidthRequest="{OnIdiom Phone=-1, Default=280}" />

            <controls:TileView Title="Export">
                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <Button Text="Termine → Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}" Margin="0,0,10,10" />
                    <Button Text="Termine → CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,10,10" />
                    <Button Text="Sport (12 Monate) → Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSportCommand}" Margin="0,0,10,10" />
                    <Button Text="Sync-Protokoll → Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSyncLogCommand}" Margin="0,0,10,10" />
                </FlexLayout>
            </controls:TileView>

            <Label Text="{Binding Status}" Style="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
