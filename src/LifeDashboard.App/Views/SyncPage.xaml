<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LifeDashboard.App.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:LifeDashboard.App.Controls"
    xmlns:vm="clr-namespace:LifeDashboard.App.ViewModels"
    x:DataType="vm:SyncViewModel"
    Title="Sync">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12', Default='28,24'}" Spacing="16" MaximumWidthRequest="1000">
            <Label Text="Synchronisieren" Style="{StaticResource PageTitle}" />

            <controls:TileView Title="Optionen">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Dry-Run (nur Vorschau)" FontAttributes="Bold" />
                            <Label Text="Zeigt, was geändert würde, ohne etwas zu schreiben." Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DryRun}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Löschungen ausführen" FontAttributes="Bold" />
                            <Label Text="Aus: Löschungen werden nur vorgemerkt (Bestätigung aus dem Report)." Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ConfirmDeletes}" />
                    </Grid>
                    <Button Text="Sync starten" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Fortschritt">
                <VerticalStackLayout Spacing="8">
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />
                    <Label Text="{Binding Summary}" />
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <VerticalStackLayout><Label Text="{Binding Created}" Style="{StaticResource BigNumber}" /><Label Text="neu" Style="{StaticResource Muted}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"><Label Text="{Binding Updated}" Style="{StaticResource BigNumber}" /><Label Text="aktualisiert" Style="{StaticResource Muted}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"><Label Text="{Binding Deleted}" Style="{StaticResource BigNumber}" /><Label Text="gelöscht" Style="{StaticResource Muted}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"><Label Text="{Binding Conflicts}" Style="{StaticResource BigNumber}" /><Label Text="Konflikte" Style="{StaticResource Muted}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="{Binding Errors}" Style="{StaticResource BigNumber}" /><Label Text="Fehler" Style="{StaticResource Muted}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="2"><Label Text="{Binding PendingDeletes}" Style="{StaticResource BigNumber}" /><Label Text="Löschung offen" Style="{StaticResource Muted}" /></VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Änderungen">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Actions}">
                    <BindableLayout.EmptyView>
                        <Label Text="Noch keine Änderungen." Style="{StaticResource Muted}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SyncActionItem">
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                <Label Text="{Binding Kind}" FontAttributes="Bold" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" />
                                    <Label Text="{Binding Target, StringFormat='→ {0}'}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding Reason}" Style="{StaticResource Badge}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Verlauf (letzte 10 Läufe)">
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding History}">
                    <BindableLayout.EmptyView>
                        <Label Text="Noch keine Läufe." Style="{StaticResource Muted}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SyncRunItem">
                            <Grid ColumnDefinitions="150,80,*" ColumnSpacing="8">
                                <Label Text="{Binding When}" Style="{StaticResource Muted}" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Kind}" FontAttributes="Bold" />
                                    <Label Text="{Binding Status}" Style="{StaticResource Badge}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </controls:TileView>

            <controls:TileView Title="Live-Log">
                <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Log}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontFamily="{OnPlatform WinUI=Consolas, iOS=Menlo}" FontSize="12" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </controls:TileView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
