<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LifeDashboard.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeDashboard.App.ViewModels"
    x:DataType="vm:CalendarViewModel"
    Title="Kalender">

    <CollectionView ItemsSource="{Binding Days}" IsGrouped="True" Margin="{OnIdiom Phone='16,0', Default='28,0'}">
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,16,0,8">
                <Label Text="Nächste 14 Tage" Style="{StaticResource PageTitle}" />
                <Label Text="Alle Kalender inkl. geteilter (read-only) Kalender." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:DayGroup">
                <Label Text="{Binding Title}" Style="{StaticResource TileTitle}" Padding="0,16,0,6" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:EventItem">
                <Border Style="{StaticResource Tile}" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding When}" Style="{StaticResource Muted}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding CalendarName}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource Badge}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="Keine Termine." Style="{StaticResource Muted}" Margin="0,24" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
