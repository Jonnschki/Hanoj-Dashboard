<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Adaptive Navigation:
    - Windows (Desktop): fest angedockte linke Navigationsleiste (Flyout "Locked"), keine Tab-Leiste.
    - iPhone: kein Flyout, stattdessen Tabs unten. Einstellungen über das Zahnrad (Push-Route "settings"),
      damit es maximal 5 Tabs gibt (ab 6 Tabs zeigt iOS sonst ein "Mehr"-Menü).
-->
<Shell
    x:Class="LifeDashboard.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LifeDashboard.App.Views"
    Title="Life Dashboard"
    FlyoutBehavior="{OnIdiom Desktop=Locked, Default=Disabled}"
    FlyoutWidth="230">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,24,20,12" Spacing="2">
            <Label Text="Life Dashboard" Style="{StaticResource PageTitle}" FontSize="20" />
            <Label Text="Alles im Kalender." Style="{StaticResource Muted}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Übersicht" FlyoutDisplayOptions="AsMultipleItems" Shell.TabBarIsVisible="{OnIdiom Desktop=False, Default=True}">
        <ShellContent Title="Dashboard" Icon="tab_dashboard.png" Route="dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Sync" Icon="tab_sync.png" Route="sync" ContentTemplate="{DataTemplate views:SyncPage}" />
        <ShellContent Title="Kalender" Icon="tab_calendar.png" Route="calendar" ContentTemplate="{DataTemplate views:CalendarPage}" />
        <ShellContent Title="Sport" Icon="tab_sport.png" Route="sport" ContentTemplate="{DataTemplate views:SportPage}" />
        <ShellContent Title="Digest" Icon="tab_digest.png" Route="digest" ContentTemplate="{DataTemplate views:DigestPage}" />
    </FlyoutItem>

    <!-- Nur auf dem Desktop sichtbar; auf dem iPhone über die Push-Route "settings". -->
    <FlyoutItem Title="Einstellungen" Icon="tab_settings.png" Route="settingsroot" IsVisible="{OnIdiom Desktop=True, Default=False}">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

</Shell>
